[Unit]
Description=Del Roar speech to text
PartOf=delroar.target
After=delroar-renderer.service
BindsTo=delroar-renderer.service

# keep retrying forever: no giving up after a few fast failures at boot
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/delroar
Environment=PYTHONUNBUFFERED=1
# --device: the handset adapter. "pipewire" follows the system default input;
# a number from `python3 stt.py --list-devices` pins one adapter.
ExecStart=/usr/bin/python3 stt.py --device pipewire --model base.en
Restart=always
RestartSec=3

[Install]
WantedBy=delroar.target
